import { describe, expect, it } from "vitest";
import { getIngredient } from "../data/ingredients";
import { RECIPES } from "../data/recipes";
import { resolveShopEntitlement } from "../state/materialEntitlement";
import { loadSave, type StorageLike } from "../state/persistence";
import { __P___HV_SCENARIOS, __P___RECIPE_IDS, apply__P__HvSeed, __TAG__OwnedMaterials, __TAG__TargetMaterials, build__P__HvSnapshot, find__P__HvScenario, parse__P__HvParam } from "./__TAG__HvSeeds";
import { applyPreviewHvSeed } from "./hvSeeds";

/** __LABEL__ Preview-only HV seeds (GENERATED by tools/train-kit; template: tools/train-kit/templates/hvSeeds.test.ts.tmpl): consistent saves, the Shop offers the target's new materials as NEW, the target recipe is undiscovered, only the Preview key is written, a reload never reseeds. */
function memory(seed: Record<string, string> = {}): StorageLike & { map: Map<string, string> } {
  const map = new Map(Object.entries(seed));
  return { map, getItem: (k) => map.get(k) ?? null, setItem: (k, v) => void map.set(k, v), removeItem: (k) => void map.delete(k) };
}
const isFinite = (id: string) => !!getIngredient(id)?.unlockCondition;

describe("__P__ HV seeds", () => {
  it("parses only its own ids (one per key recipe of the train)", () => {
    expect(__P___HV_SCENARIOS.map((s) => s.recipeId)).toEqual([...__P___RECIPE_IDS]);
    for (const s of __P___HV_SCENARIOS) expect(parse__P__HvParam(`?hv=${s.id}`)).toBe(s.id);
    for (const bad of ["?hv=b22-truffle", "?hv=b23-apple-cinnamon", "?hv=b23b-nutella", "?hv=b21-taco", "?hv=b18-bbq", "?hv=normal", "", "?x=1", undefined, 7]) expect(parse__P__HvParam(bad)).toBeNull();
  });

  it.each(__P___HV_SCENARIOS)("$id: a consistent save — the target's own materials are not owned, the target is not discovered, every discovered recipe's finite materials are owned, owned materials are stocked", (s) => {
    const snap = build__P__HvSnapshot(s);
    const own = __TAG__TargetMaterials(s.recipeId);
    expect(own.length).toBeGreaterThan(0);
    for (const id of own) expect(snap.ownedIngredientIds, id).not.toContain(id);
    expect(__TAG__OwnedMaterials(s).some((id) => own.includes(id))).toBe(false);
    const dexIds = snap.dex.map((e) => e.recipeId);
    expect(dexIds).not.toContain(s.recipeId);
    for (const r of RECIPES.filter((x) => dexIds.includes(x.id))) {
      for (const q of r.requiredIngredients) if (isFinite(q.ingredientId)) expect(snap.ownedIngredientIds, `${r.id}/${q.ingredientId}`).toContain(q.ingredientId);
    }
    for (const id of snap.ownedIngredientIds.filter(isFinite)) expect(snap.inventory[id], id).toBeGreaterThan(0);
  });

  it.each(__P___HV_SCENARIOS)("$id: the load-time entitlement grants the target's new materials (the Shop offers them as NEW)", (s) => {
    const snap = build__P__HvSnapshot(s);
    const ent = resolveShopEntitlement(snap.dex, snap.ownedIngredientIds, snap.unlockedForShopIngredientIds ?? []);
    for (const id of __TAG__TargetMaterials(s.recipeId)) expect(ent.unlockedForShopIngredientIds, id).toContain(id);
  });

  it.each(__P___HV_SCENARIOS)("$id: applying the seed writes a loadable save with the target undiscovered; a reload does not reseed", (s) => {
    const storage = memory();
    expect(applyPreviewHvSeed(`?hv=${s.id}`, storage, "navigate")).toBe(s.id);
    const stored = loadSave(storage);
    expect(stored.dex.some((e) => e.recipeId === s.recipeId)).toBe(false);
    expect(stored.pitzBalance).toBe(find__P__HvScenario(s.id)!.pitz);
    const before = [...storage.map.entries()].join("|");
    expect(applyPreviewHvSeed(`?hv=${s.id}`, storage, "reload")).toBeNull();
    expect([...storage.map.entries()].join("|")).toBe(before);
    expect(apply__P__HvSeed(s.id, memory())).toBe(true);
  });
});
