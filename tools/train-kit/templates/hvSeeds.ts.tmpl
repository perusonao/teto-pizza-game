/**
 * __LABEL__ (Issue #__ISSUE__): iPhone Safari Human Verification seeds. PREVIEW ONLY. GENERATED by tools/train-kit from the train spec
 * (template: tools/train-kit/templates/hvSeeds.ts.tmpl -- change the template, not this file; same behaviour as ./b23bHvSeeds.ts).
 *
 * `?hv=__TAG__-<recipe>` writes ONE ready-made save per key recipe of the train: every ladder material is owned EXCEPT the materials of the
 * target's own step, and every recipe those materials can make is discovered EXCEPT the target (so the load-time entitlement grants the
 * target's new materials and the Shop offers them as NEW). The seed goes through the ordinary `resetSave` / `persistProgress` / `loadSave`,
 * lands in the Preview key only and never touches a production save or Firebase. ./hvSeeds.ts applies it only for a fresh navigation,
 * behind `VITE_PREVIEW_MODE`; a production build drops this module (./previewIsolation.gate.test.ts scans for every id and label below).
 */
import { DISCOVERY_LADDER } from "../data/discoveryLadder";
import { getIngredient, STARTER_INGREDIENT_IDS } from "../data/ingredients";
import { RECIPES, type Recipe } from "../data/recipes";
import type { DexEntry } from "../state/dex";
import { loadSave, persistProgress, resetSave, type ProgressionSnapshot, type StorageLike } from "../state/persistence";
import { PREVIEW_HELPER_MARK } from "./hint5PreviewOptIn";

export type __P__HvScenarioId = /*__SCENARIO_IDS__*/;

export interface __P__HvScenario {
  id: __P__HvScenarioId;
  /** The recipe the Owner plays / checks (undiscovered in the seeded save). */
  recipeId: string;
  labelJa: string;
  pitz: number;
}

export const __P___RECIPE_IDS: readonly string[] = [/*__RECIPE_IDS__*/];
const __P___PITZ = 2000;
const __P___STOCK = 10;

export const __P___HV_SCENARIOS: readonly __P__HvScenario[] = [
/*__SCENARIOS__*/
];

export function find__P__HvScenario(id: unknown): __P__HvScenario | null {
  return typeof id === "string" ? (__P___HV_SCENARIOS.find((s) => s.id === id) ?? null) : null;
}

/** `?hv=<__TAG__ id>` (any other value is ignored). */
export function parse__P__HvParam(search: unknown): __P__HvScenarioId | null {
  if (typeof search !== "string") return null;
  return find__P__HvScenario(new URLSearchParams(search).get("hv"))?.id ?? null;
}

/** The materials unlocked by the ladder step whose key recipe is `recipeId` (the target's own new materials). */
export function __TAG__TargetMaterials(recipeId: string): string[] {
  const step = DISCOVERY_LADDER.steps.find((s) => s.keyRecipeId === recipeId);
  if (!step) throw new Error(`${PREVIEW_HELPER_MARK}: ${recipeId} is not the key recipe of a ladder step`);
  return [...step.ingredientIds];
}

/** Every ladder material except the target step's, in ladder order. */
export function __TAG__OwnedMaterials(scenario: __P__HvScenario): string[] {
  const target = new Set(__TAG__TargetMaterials(scenario.recipeId));
  return DISCOVERY_LADDER.steps.flatMap((step) => step.ingredientIds).filter((id) => !target.has(id));
}

function makeableWith(recipe: Recipe, owned: ReadonlySet<string>): boolean {
  return recipe.requiredIngredients.every(({ ingredientId }) => {
    const ingredient = getIngredient(ingredientId);
    return !!ingredient && (!ingredient.unlockCondition || owned.has(ingredientId));
  });
}

/** The save a scenario stands for, as the ordinary progression snapshot. */
export function build__P__HvSnapshot(scenario: __P__HvScenario): ProgressionSnapshot {
  const materials = __TAG__OwnedMaterials(scenario);
  const ownedSet = new Set<string>([...STARTER_INGREDIENT_IDS, ...materials]);
  const dex: DexEntry[] = RECIPES.filter((recipe) => recipe.id !== scenario.recipeId && makeableWith(recipe, ownedSet)).map((recipe) => ({
    recipeId: recipe.id,
    discovered: true,
    bestScore: 70,
    bestStars: 3,
    timesMade: 1,
  }));
  return {
    dex,
    pitzBalance: scenario.pitz,
    ownedIngredientIds: [...STARTER_INGREDIENT_IDS, ...materials],
    inventory: Object.fromEntries(materials.map((id) => [id, __P___STOCK])),
    starterGrantClaimedRecipeIds: [],
    unlockedForShopIngredientIds: materials,
    discoveryHintFacts: {},
  };
}

/** Replaces the save in `storage` with the scenario's. Returns false when the stored result is not the seed. */
export function apply__P__HvSeed(id: __P__HvScenarioId, storage: StorageLike): boolean {
  const scenario = find__P__HvScenario(id);
  if (!scenario) return false;
  if (!resetSave(storage)) return false;
  const snapshot = build__P__HvSnapshot(scenario);
  persistProgress(snapshot, storage);
  const stored = loadSave(storage);
  return stored.pitzBalance === scenario.pitz && stored.dex.length === snapshot.dex.length && !stored.dex.some((entry) => entry.recipeId === scenario.recipeId);
}
