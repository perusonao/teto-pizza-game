rules_version = '2';

// Firebase Ranking 1.0 (Issue #87). The one rule this file exists to enforce: no
// authenticated-or-otherwise client can ever write an authoritative score directly. Being
// signed in (even with a real, non-anonymous Firebase Auth user) is never treated as
// "authorized to write a score" here -- the only trusted writer of `runs/*` and
// `leaderboards/*/entries/*` is `submitLunchRushScore`'s own Admin SDK write path
// (functions/src/index.ts), which bypasses these rules entirely (Admin SDK requests are not
// subject to Security Rules). See docs/design/TETO_FIREBASE-RANKING_SETUP.md's Phase 1B/2A
// sections for the full architecture this backstops.
//
// Phase 1B shipped no ranking UI at all, so every client read was denied too, not just writes.
// Phase 2A adds the weekly leaderboard *read* path (src/firebase/getWeeklyLeaderboard.ts) --
// this is the one, minimum-necessary loosening that unlocks: `leaderboards/{periodId}/entries`
// read access is scoped to `periodId`s starting with `"weekly_"` only. `monthly_*`/`all_all`
// stay fully read-denied, exactly as before, since Phase 2A ships no monthly/all-time UI to
// justify opening them (Issue #87's own phasing) -- see this file's own rules test
// (firestore.rules.test.ts) for the exact scenarios this is verified against. No condition here
// depends on `request.auth` -- Lunch Rush scores carry no personal information (Phase 2A's UI
// never shows a uid), so gating a public leaderboard's *read* on sign-in state would add
// complexity without an actual privacy or abuse benefit; anonymous-vs-authenticated read access
// is identical.
service cloud.firestore {
  match /databases/{database}/documents {
    // The raw submission ledger -- never read by any client, ever (audit/debugging trail
    // only, read via the Firebase Console or a future Admin-only tool).
    match /runs/{runId} {
      allow read, write: if false;
    }

    match /leaderboards/{periodId}/entries/{uid} {
      allow read: if periodId.matches('^weekly_.*');
      allow write: if false;
    }

    // Player Profile 1.0 Phase 1A (Issue #129). A player's own displayName/createdAt/updatedAt
    // -- read is scoped to the document's own owner (no public read, unlike the leaderboard
    // entries above: a profile is not itself ranking data), and every client write is denied
    // unconditionally. The only writer is the `setDisplayName` Callable Function's Admin SDK
    // path (functions/src/index.ts), which bypasses these rules entirely, exactly mirroring
    // `runs`/`leaderboards` above -- being signed in (even as the document's own owner) is
    // never treated as "authorized to write" here. See docs/design/
    // TETO_PLAYER-PROFILE_1.0.md section 8 for the full threat table this backstops.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Deny-by-default backstop for any collection not explicitly matched above -- a new
    // collection added later must have its own explicit rule to be reachable at all.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
