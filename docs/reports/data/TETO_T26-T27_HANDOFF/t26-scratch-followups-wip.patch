new file mode 100644
index 00000000..d4fb3508
--- /dev/null
+++ b/src/preview/t26HvSeeds.test.ts
@@ -0,0 +1,54 @@
+import { describe, expect, it } from "vitest";
+import { getIngredient } from "../data/ingredients";
+import { RECIPES } from "../data/recipes";
+import { resolveShopEntitlement } from "../state/materialEntitlement";
+import { loadSave, type StorageLike } from "../state/persistence";
+import { T26_HV_SCENARIOS, T26_RECIPE_IDS, applyT26HvSeed, t26OwnedMaterials, t26TargetMaterials, buildT26HvSnapshot, findT26HvScenario, parseT26HvParam } from "./t26HvSeeds";
+import { applyPreviewHvSeed } from "./hvSeeds";
+
+/** Expansion Batch 26 Preview-only HV seeds (GENERATED by tools/train-kit; template: tools/train-kit/templates/hvSeeds.test.ts.tmpl): consistent saves, the Shop offers the target's new materials as NEW, the target recipe is undiscovered, only the Preview key is written, a reload never reseeds. */
+function memory(seed: Record<string, string> = {}): StorageLike & { map: Map<string, string> } {
+  const map = new Map(Object.entries(seed));
+  return { map, getItem: (k) => map.get(k) ?? null, setItem: (k, v) => void map.set(k, v), removeItem: (k) => void map.delete(k) };
+}
+const isFinite = (id: string) => !!getIngredient(id)?.unlockCondition;
+
+describe("T26 HV seeds", () => {
+  it("parses only its own ids (one per key recipe of the train)", () => {
+    expect(T26_HV_SCENARIOS.map((s) => s.recipeId)).toEqual([...T26_RECIPE_IDS]);
+    for (const s of T26_HV_SCENARIOS) expect(parseT26HvParam(`?hv=${s.id}`)).toBe(s.id);
+    for (const bad of ["?hv=b22-truffle", "?hv=b23-apple-cinnamon", "?hv=b23b-nutella", "?hv=b21-taco", "?hv=b18-bbq", "?hv=normal", "", "?x=1", undefined, 7]) expect(parseT26HvParam(bad)).toBeNull();
+  });
+
+  it.each(T26_HV_SCENARIOS)("$id: a consistent save — the target's own materials are not owned, the target is not discovered, every discovered recipe's finite materials are owned, owned materials are stocked", (s) => {
+    const snap = buildT26HvSnapshot(s);
+    const own = t26TargetMaterials(s.recipeId);
+    expect(own.length).toBeGreaterThan(0);
+    for (const id of own) expect(snap.ownedIngredientIds, id).not.toContain(id);
+    expect(t26OwnedMaterials(s).some((id) => own.includes(id))).toBe(false);
+    const dexIds = snap.dex.map((e) => e.recipeId);
+    expect(dexIds).not.toContain(s.recipeId);
+    for (const r of RECIPES.filter((x) => dexIds.includes(x.id))) {
+      for (const q of r.requiredIngredients) if (isFinite(q.ingredientId)) expect(snap.ownedIngredientIds, `${r.id}/${q.ingredientId}`).toContain(q.ingredientId);
+    }
+    for (const id of snap.ownedIngredientIds.filter(isFinite)) expect(snap.inventory[id], id).toBeGreaterThan(0);
+  });
+
+  it.each(T26_HV_SCENARIOS)("$id: the load-time entitlement grants the target's new materials (the Shop offers them as NEW)", (s) => {
+    const snap = buildT26HvSnapshot(s);
+    const ent = resolveShopEntitlement(snap.dex, snap.ownedIngredientIds, snap.unlockedForShopIngredientIds ?? []);
+    for (const id of t26TargetMaterials(s.recipeId)) expect(ent.unlockedForShopIngredientIds, id).toContain(id);
+  });
+
+  it.each(T26_HV_SCENARIOS)("$id: applying the seed writes a loadable save with the target undiscovered; a reload does not reseed", (s) => {
+    const storage = memory();
+    expect(applyPreviewHvSeed(`?hv=${s.id}`, storage, "navigate")).toBe(s.id);
+    const stored = loadSave(storage);
+    expect(stored.dex.some((e) => e.recipeId === s.recipeId)).toBe(false);
+    expect(stored.pitzBalance).toBe(findT26HvScenario(s.id)!.pitz);
+    const before = [...storage.map.entries()].join("|");
+    expect(applyPreviewHvSeed(`?hv=${s.id}`, storage, "reload")).toBeNull();
+    expect([...storage.map.entries()].join("|")).toBe(before);
+    expect(applyT26HvSeed(s.id, memory())).toBe(true);
+  });
+});
diff --git a/src/preview/t26HvSeeds.ts b/src/preview/t26HvSeeds.ts
new file mode 100644
index 00000000..cb830dea
--- /dev/null
+++ b/src/preview/t26HvSeeds.ts
@@ -0,0 +1,97 @@
+/**
+ * Expansion Batch 26 (Issue #780): iPhone Safari Human Verification seeds. PREVIEW ONLY. GENERATED by tools/train-kit from the train spec
+ * (template: tools/train-kit/templates/hvSeeds.ts.tmpl -- change the template, not this file; same behaviour as ./b23bHvSeeds.ts).
+ *
+ * `?hv=t26-<recipe>` writes ONE ready-made save per key recipe of the train: every ladder material is owned EXCEPT the materials of the
+ * target's own step, and every recipe those materials can make is discovered EXCEPT the target (so the load-time entitlement grants the
+ * target's new materials and the Shop offers them as NEW). The seed goes through the ordinary `resetSave` / `persistProgress` / `loadSave`,
+ * lands in the Preview key only and never touches a production save or Firebase. ./hvSeeds.ts applies it only for a fresh navigation,
+ * behind `VITE_PREVIEW_MODE`; a production build drops this module (./previewIsolation.gate.test.ts scans for every id and label below).
+ */
+import { DISCOVERY_LADDER } from "../data/discoveryLadder";
+import { getIngredient, STARTER_INGREDIENT_IDS } from "../data/ingredients";
+import { RECIPES, type Recipe } from "../data/recipes";
+import type { DexEntry } from "../state/dex";
+import { loadSave, persistProgress, resetSave, type ProgressionSnapshot, type StorageLike } from "../state/persistence";
+import { PREVIEW_HELPER_MARK } from "./hint5PreviewOptIn";
+
+export type T26HvScenarioId = "t26-nduja-pizza";
+
+export interface T26HvScenario {
+  id: T26HvScenarioId;
+  /** The recipe the Owner plays / checks (undiscovered in the seeded save). */
+  recipeId: string;
+  labelJa: string;
+  pitz: number;
+}
+
+export const T26_RECIPE_IDS: readonly string[] = ["nduja-pizza"];
+const T26_PITZ = 2000;
+const T26_STOCK = 10;
+
+export const T26_HV_SCENARIOS: readonly T26HvScenario[] = [
+  { id: "t26-nduja-pizza", recipeId: "nduja-pizza", labelJa: "T26-1: ンドゥイヤピザ (ンドゥイヤの購入から)", pitz: T26_PITZ },
+];
+
+export function findT26HvScenario(id: unknown): T26HvScenario | null {
+  return typeof id === "string" ? (T26_HV_SCENARIOS.find((s) => s.id === id) ?? null) : null;
+}
+
+/** `?hv=<t26 id>` (any other value is ignored). */
+export function parseT26HvParam(search: unknown): T26HvScenarioId | null {
+  if (typeof search !== "string") return null;
+  return findT26HvScenario(new URLSearchParams(search).get("hv"))?.id ?? null;
+}
+
+/** The materials unlocked by the ladder step whose key recipe is `recipeId` (the target's own new materials). */
+export function t26TargetMaterials(recipeId: string): string[] {
+  const step = DISCOVERY_LADDER.steps.find((s) => s.keyRecipeId === recipeId);
+  if (!step) throw new Error(`${PREVIEW_HELPER_MARK}: ${recipeId} is not the key recipe of a ladder step`);
+  return [...step.ingredientIds];
+}
+
+/** Every ladder material except the target step's, in ladder order. */
+export function t26OwnedMaterials(scenario: T26HvScenario): string[] {
+  const target = new Set(t26TargetMaterials(scenario.recipeId));
+  return DISCOVERY_LADDER.steps.flatMap((step) => step.ingredientIds).filter((id) => !target.has(id));
+}
+
+function makeableWith(recipe: Recipe, owned: ReadonlySet<string>): boolean {
+  return recipe.requiredIngredients.every(({ ingredientId }) => {
+    const ingredient = getIngredient(ingredientId);
+    return !!ingredient && (!ingredient.unlockCondition || owned.has(ingredientId));
+  });
+}
+
+/** The save a scenario stands for, as the ordinary progression snapshot. */
+export function buildT26HvSnapshot(scenario: T26HvScenario): ProgressionSnapshot {
+  const materials = t26OwnedMaterials(scenario);
+  const ownedSet = new Set<string>([...STARTER_INGREDIENT_IDS, ...materials]);
+  const dex: DexEntry[] = RECIPES.filter((recipe) => recipe.id !== scenario.recipeId && makeableWith(recipe, ownedSet)).map((recipe) => ({
+    recipeId: recipe.id,
+    discovered: true,
+    bestScore: 70,
+    bestStars: 3,
+    timesMade: 1,
+  }));
+  return {
+    dex,
+    pitzBalance: scenario.pitz,
+    ownedIngredientIds: [...STARTER_INGREDIENT_IDS, ...materials],
+    inventory: Object.fromEntries(materials.map((id) => [id, T26_STOCK])),
+    starterGrantClaimedRecipeIds: [],
+    unlockedForShopIngredientIds: materials,
+    discoveryHintFacts: {},
+  };
+}
+
+/** Replaces the save in `storage` with the scenario's. Returns false when the stored result is not the seed. */
+export function applyT26HvSeed(id: T26HvScenarioId, storage: StorageLike): boolean {
+  const scenario = findT26HvScenario(id);
+  if (!scenario) return false;
+  if (!resetSave(storage)) return false;
+  const snapshot = buildT26HvSnapshot(scenario);
+  persistProgress(snapshot, storage);
+  const stored = loadSave(storage);
+  return stored.pitzBalance === scenario.pitz && stored.dex.length === snapshot.dex.length && !stored.dex.some((entry) => entry.recipeId === scenario.recipeId);
+}
diff --git a/src/state/ndujaInventory.contract.test.ts b/src/state/ndujaInventory.contract.test.ts
new file mode 100644
index 00000000..2ba41e05
--- /dev/null
+++ b/src/state/ndujaInventory.contract.test.ts
@@ -0,0 +1,54 @@
+import { describe, expect, it } from "vitest";
+import { getIngredient } from "../data/ingredients";
+import { trayStockDisplay } from "../logic/trayStockDisplay";
+import { canPlaceIngredient, consumePizzaInventory, hasStock, remainingStock, type InventoryState } from "./inventory";
+import { createEmptyPizza, type PizzaState } from "./pizzaState";
+
+/**
+ * T26 (Owner 2026-11-17/18, D-T26-NDUJA-PLACEMENT): nduja is placed as small separate dollops, the inventory unit stays `use`, and
+ * ONE use = ONE dollop = ONE piece = stock 1 (the Shop pack of 20 = 10 pizzas x 2 dollops). The runtime has no unit field, so this
+ * contract pins the equivalence end to end: placing, the tray count, the stock gate and the bake-time consumption all agree.
+ */
+const nduja = getIngredient("nduja")!;
+const withDollops = (n: number): PizzaState => ({
+  ...createEmptyPizza(),
+  toppings: Array.from({ length: n }, (_, i) => ({ id: `nd-${i}`, ingredientId: "nduja", x: 30 + i * 10, y: 50 })),
+});
+
+describe("nduja inventory contract: 1 dollop = 1 use = stock 1", () => {
+  it("is a finite scatter ingredient (so each placed piece is counted and consumed)", () => {
+    expect(nduja.placement).toBe("scatter");
+    expect(nduja.unlockCondition).toBeDefined();
+  });
+
+  it("placing one dollop consumes exactly 1 stock at the bake (CONFIRM_BAKE), not the recipe minimum and not a whole pizza", () => {
+    const stock: InventoryState = { nduja: 20 };
+    expect(consumePizzaInventory(withDollops(1), stock).nduja).toBe(19);
+    expect(consumePizzaInventory(withDollops(2), stock).nduja).toBe(18);
+    expect(consumePizzaInventory(withDollops(3), stock).nduja).toBe(17);
+  });
+
+  it("the tray count falls by 1 per placed dollop and reaches 0 exactly when the stock gate refuses", () => {
+    const stock: InventoryState = { nduja: 2 };
+    expect(trayStockDisplay(nduja, stock, withDollops(0))).toBe(2);
+    expect(trayStockDisplay(nduja, stock, withDollops(1))).toBe(1);
+    expect(trayStockDisplay(nduja, stock, withDollops(2))).toBe(0);
+    expect(canPlaceIngredient(nduja, stock, withDollops(1))).toBe(true);
+    expect(canPlaceIngredient(nduja, stock, withDollops(2))).toBe(false);
+  });
+
+  it("with stock 0 no dollop can be placed; consumption never goes below 0", () => {
+    expect(hasStock(nduja, { nduja: 0 }, 0)).toBe(false);
+    expect(canPlaceIngredient(nduja, { nduja: 0 }, withDollops(0))).toBe(false);
+    expect(consumePizzaInventory(withDollops(3), { nduja: 1 }).nduja).toBe(0);
+  });
+
+  it("the Shop pack of 20 covers exactly 10 pizzas of the 2-dollop recipe (stock reaches 0 after the tenth)", () => {
+    let stock: InventoryState = { nduja: 20 };
+    for (let pizza = 0; pizza < 10; pizza++) {
+      expect(remainingStock(nduja, stock)).toBe(20 - pizza * 2);
+      stock = consumePizzaInventory(withDollops(2), stock);
+    }
+    expect(remainingStock(nduja, stock)).toBe(0);
+  });
+});
